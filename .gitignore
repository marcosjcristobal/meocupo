# Ignore the project-specific Python virtual environment.
.venv/

# Ignore directories containing compiled Python bytecode.
__pycache__/

# Ignore compiled Python files that may exist outside those directories.
*.py[cod]

# Ignore package metadata generated by local and editable installations.
*.egg-info/

# Ignore the cache Pytest uses to remember information between test runs.
.pytest_cache/

# Ignore local environment files because they may contain credentials or secrets.
.env
.env.*

# Keep a documented example file that never contains real secret values.
!.env.example
